{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0",
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:vite": "vite --host --mode development",
    "prod": "cross-env NODE_ENV=production vite --host --mode production",
    "build": "rm -rf dist && vite build --mode development",
    "build:prod": "rm -rf dist && cross-env NODE_ENV=production vite build --mode production",
    "build:analyze": "rm -rf dist && cross-env ANALYZE=1 NODE_ENV=production vite build --mode production",
    "preview": "vite preview",
    "deploy": "bun run build:prod && wrangler deploy",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format src/",
    "format:fix": "biome format --write src/",
    "check:biome": "biome check src/",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build:prod",
    "check:ci": "bun run check && bun audit --audit-level=moderate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "preact": "^10.29.8",
    "preact-iso": "^2.12.2",
    "preact-render-to-string": "^6.7.0",
    "react-helmet-async": "^3.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@cloudflare/workers-types": "^5.20260901.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^5.0.0",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx,json,md}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "semver": "^7.6.3",
    "undici": "^7.24.0",
    "js-yaml": "^4.1.1",
    "lodash": "^4.17.23",
    "brace-expansion": "^5.0.5",
    "flatted": "^3.4.0",
    "picomatch": ">=2.3.2",
    "yaml": ">=2.8.3"
  }
}
